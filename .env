# Copy this file to .env, create the fernshub_db database in PostgreSQL,
# and replace CHANGE_ME with your local PostgreSQL password.
DATABASE_URL=postgresql://postgres:1234@localhost:5432/fernshub_db

# Alternatively, comment out DATABASE_URL and use these settings:
DB_NAME=fernshub_db
DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=localhost
DB_PORT=5432

# Local development: use HTTP, not HTTPS
DJANGO_DEBUG=True
